rules_version = '2';

// GymAppAI - Firestore Security Rules
//
// Koleksiyonlar:
//   users/{uid}       - kisisel yedek verisi (sadece sahip erisir)
//   profiles/{uid}    - herkese acik arkadas profili (isim/kod/xp/seviye)
//   requests/{to}_{from} - arkadaslik istekleri
//   friendships/{a}_{b}  - arkadaslik eslesmesi (a < b alfabetik)
//   rateLimits/{uid}  - Cloud Function yazar, istemci kapali

service cloud.firestore {
  match /databases/{database}/documents {

    // User backup data: users/{uid} (cloudSync.js)
    match /users/{userId} {
      allow read, write: if request.auth != null
                          && request.auth.uid == userId;
    }

    // ---------------------------------------------------------------
    // ARKADAS SISTEMI
    // ---------------------------------------------------------------

    // profiles/{uid}: lider tablosu icin herkes OKUYABILIR (giris sart).
    // Yazma: sadece sahibi; name<=30 karakter, xp/level sayisal sinirli.
    match /profiles/{uid} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 30
                    && request.resource.data.code is string
                    && request.resource.data.code.size() == 6
                    && request.resource.data.xp is int
                    && request.resource.data.xp >= 0
                    && request.resource.data.xp <= 100000000
                    && request.resource.data.level is int
                    && request.resource.data.level >= 1
                    && request.resource.data.level <= 1000;

      allow update: if request.auth != null
                    && request.auth.uid == uid
                    // code degistirilemez!
                    && request.resource.data.code == resource.data.code
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 30
                    && request.resource.data.xp is int
                    && request.resource.data.xp >= 0
                    && request.resource.data.xp <= 100000000
                    && request.resource.data.level is int
                    && request.resource.data.level >= 1
                    && request.resource.data.level <= 1000;

      allow delete: if request.auth != null
                    && request.auth.uid == uid;
    }

    // requests/{toUid}_{fromUid}: fromUid olusturur (kendisi adina),
    // toUid okur ve siler (kabul/red). Baskalari erisemez.
    match /requests/{docId} {
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.to
                      || request.auth.uid == resource.data.from);

      allow create: if request.auth != null
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.to != request.auth.uid
                    && request.resource.data.fromName is string
                    && request.resource.data.fromName.size() <= 30;

      // Kabul/red istegi siler; gonderen de istegini geri cekebilir.
      allow delete: if request.auth != null
                    && (request.auth.uid == resource.data.to
                        || request.auth.uid == resource.data.from);

      // istekler guncellenmez
      allow update: if false;
    }

    // friendships/{a}_{b} (a < b): iki taraftan biri olusturabilir
    // (istegi kabul eden kisi yazar), sadece taraflar silebilir.
    // Okuma: eslesmenin tarafi olanlar.
    match /friendships/{docId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.users;

      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.users
                    && request.resource.data.users.size() == 2
                    // oz-eslesme yasak
                    && request.resource.data.users[0] != request.resource.data.users[1];

      allow delete: if request.auth != null
                    && request.auth.uid in resource.data.users;

      // eslesme guncellenmez
      allow update: if false;
    }

    // ---------------------------------------------------------------

    // Rate-limit counters (written by Cloud Functions):
    // rateLimits/{uid} - users cannot read their own counter; only CF (Admin SDK) writes.
    // Admin SDK bypasses these rules; client access is closed.
    match /rateLimits/{userId} {
      allow read, write: if false;
    }

    // Explicit default-deny for any other path.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
