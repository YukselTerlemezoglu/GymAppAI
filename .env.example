# Firebase Configuration
# Bu değerler gizli değildir - Firebase istemci SDK'sının herkese açık yapılandırmasıdır.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_APP_ID"

# Admin Panel (client-side convenience only; not real security)
VITE_ADMIN_PASSWORD="YOUR_ADMIN_PASSWORD"

# ÖNEMLİ: Groq API anahtarı ARTIK burada DEĞİL!
# O Cloud Functions'da Secret Manager'da saklanır.
# Ayarlama: firebase functions:secrets:set GROQ_API_KEY
